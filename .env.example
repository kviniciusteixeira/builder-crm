# ============================================================================
# Para TESTAR o CRM não precisa de nada deste arquivo: `npm run local` sobe
# uma base embutida e abre o CRM com dados de demonstração. O único que você
# pode querer copiar aqui é OPENROUTER_API_KEY, para o agente responder no
# simulador.
#
# Este arquivo é para uma instância DE VERDADE (seu Supabase, seu domínio).
# ============================================================================

# ============================================================================
# Builder CRM - variáveis de ambiente
# ============================================================================
# Copiar para .env.local (desenvolvimento) ou carregar no Coolify (produção). NUNCA
# commitar .env.local. No Coolify vão TODAS em runtime: desde 1.2.2 o servidor
# entrega ao navegador a configuração pública na execução, então não há que marcar
# nenhuma como "Build Variable". As NEXT_PUBLIC_* viajam ao navegador (não são secretas)
# e o Dockerfile também as aceita como build args, caso você construa numa plataforma
# que as horneia. Os placeholders REEMPLAZA_ não funcionam: há que trocá-los.
#
# Obrigatórias: DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# e AGENT_WORKER_SECRET (desde 2.0.0; sem ela as rotas internas respondem 401).
# Todo o resto liga uma capacidade; sem isso o CRM sobe igual e a UI avisa.

# ----------------------------------------------------------------------------
# SUPABASE (base de dados + auth) - um projeto por cliente
# ----------------------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://REEMPLAZA_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZA_anon_key
# Service role: SÓ servidor (criar usuários em Ajustes -> Equipo e scripts). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_service_role_key
# Dashboard -> Connect. O app usa o pooler em modo transação (porta 6543):
DATABASE_URL=postgresql://postgres.REEMPLAZA_ref:REEMPLAZA_password@aws-0-REEMPLAZA_region.pooler.supabase.com:6543/postgres
# A conexão vai com TLS obrigatório (ssl: require). Para um Postgres na mesma
# máquina ou na rede interna do Docker, onde não há certificado:
# DATABASE_SSL=off
# Opcional: conexão direta (porta 5432) para as migrações. Se faltar, usa-se DATABASE_URL.
# DIRECT_URL=postgresql://postgres.REEMPLAZA_ref:REEMPLAZA_password@aws-0-REEMPLAZA_region.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
# URL pública da instância (sem barra final). Usam-na o webhook para chamar o
# worker, os scripts e os links das notificações.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# O cadastro público fica aberto só enquanto não houver membros (a primeira conta é
# admin). "true" o deixa aberto sempre: só para testes.
# ALLOW_PUBLIC_SIGNUP=false

# ----------------------------------------------------------------------------
# SEGREDOS INTERNOS (gerar: openssl rand -hex 32)
# ----------------------------------------------------------------------------
# OBRIGATÓRIA desde 2.0.0. Protege o worker do agente, as varreduras, o simulador por
# script e o seed demo: são rotas públicas (chama-as um cron ou o próprio servidor, sem
# sessão) e este segredo é o único que as separa da internet. Até 1.6.1, se estivesse
# vazia a verificação era PULADA e ficavam abertas sem nenhum sintoma. Agora falha
# fechada: sem esta variável o agente não roda e /api/health devolve 503.
AGENT_WORKER_SECRET=REEMPLAZA_openssl_rand_hex_32
# Header x-webhook-secret do webhook genérico de leads (/api/webhooks/leads).
LEADS_WEBHOOK_SECRET=REEMPLAZA_openssl_rand_hex_32

# ----------------------------------------------------------------------------
# AGENTE DE IA (OpenRouter: uma chave, qualquer modelo)
# ----------------------------------------------------------------------------
# openrouter.ai -> Keys. Sem isto o agente e o simulador não respondem.
OPENROUTER_API_KEY=REEMPLAZA_openrouter_key
# Modelo (manda sobre config.agente.modelo). Ex: google/gemini-2.5-flash,
# anthropic/claude-sonnet-4.5, openai/gpt-5-mini
AGENT_MODEL=google/gemini-2.5-flash

# ----------------------------------------------------------------------------
# ZERNIO (WhatsApp + Instagram DM + Messenger com uma só API e um só webhook)
# ----------------------------------------------------------------------------
# zernio.com -> Settings -> API Keys
ZERNIO_API_KEY=REEMPLAZA_sk_zernio
# Perfil do Zernio (npm run zernio:setup os lista). Vazio = perfil Default.
ZERNIO_PROFILE_ID=
# Segredo que você inventa e registra com `npm run zernio:webhook -- --url https://...`.
# Tem que ser IDÊNTICO aqui e na assinatura: se não, 401 silencioso e não entram
# mensagens. Vazio = o webhook rejeita tudo (fail-closed).
ZERNIO_WEBHOOK_SECRET=REEMPLAZA_openssl_rand_hex_32
# Provedor de WhatsApp: zernio (default) | meta (válvula de escape: Cloud API direto).
WHATSAPP_PROVIDER=zernio
# ZERNIO_API_BASE=https://zernio.com/api/v1

# ----------------------------------------------------------------------------
# META CLOUD API DIRETO (só com WHATSAPP_PROVIDER=meta, ou para BYO-WABA no Zernio)
# ----------------------------------------------------------------------------
# developers.facebook.com -> seu app -> WhatsApp -> API Setup
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# App -> Settings -> Basic -> App Secret (assinatura X-Hub-Signature-256 do webhook)
# WHATSAPP_APP_SECRET=
# Você inventa e coloca na Meta ao cadastrar o webhook.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# Só para os scripts de conexão (npm run connect:whatsapp / zernio:whatsapp):
# WHATSAPP_DISPLAY_PHONE=
# WHATSAPP_TWO_STEP_PIN=

# ----------------------------------------------------------------------------
# ENTRAR COM GOOGLE (opcional). Configura-se no servidor de autenticação, não aqui.
# ----------------------------------------------------------------------------
# O CRM não tem variáveis próprias para isto: pergunta ao provedor o que está
# ligado e desenha o botão sozinho. Auto-hospedado, as três variáveis vão no GoTrue;
# no Supabase cloud, o interruptor do painel. Passo a passo: docs/GOOGLE-AUTH.md
#
#   GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
#   GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
#   GOTRUE_EXTERNAL_GOOGLE_SECRET=...
#   GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://auth.tudominio.com/auth/v1/callback
#
# Entrar com Google NÃO dá acesso sozinho: a pessoa tem que estar em
# Ajustes -> Equipo com esse mesmo e-mail, ou cai em /sin-acceso.

# ----------------------------------------------------------------------------
# E-MAILS DE ACESSO (opcional): convites e "olvide mi contrasena"
# ----------------------------------------------------------------------------
# O SMTP fica no servidor de autenticação, não aqui. Esta variável só diz ao
# CRM que esse servidor SIM manda e-mails, para oferecer convidar por e-mail, o botão de
# reenviar acesso e o "la olvidaste?" do login.
#
# É preciso declará-lo à mão porque o GoTrue sem SMTP não falha: engole o e-mail e
# responde 200. Ligue só quando um e-mail de teste chegar de verdade, ou a UI
# vai dizer "invitacion enviada" sobre algo que nunca saiu.
# Passo a passo (Resend, Supabase cloud, modelos): docs/CORREIO.md
# AUTH_ENVIA_CORREOS=false
#
# Auto-hospedado, no contêiner de autenticação:
#   GOTRUE_SMTP_HOST=smtp.resend.com
#   GOTRUE_SMTP_PORT=465
#   GOTRUE_SMTP_USER=resend
#   GOTRUE_SMTP_PASS=re_...
#   GOTRUE_SMTP_ADMIN_EMAIL=crm@send.tudominio.com
#   GOTRUE_MAILER_TEMPLATES_INVITE=https://crm.tudominio.com/correo/invitacion.html
#   GOTRUE_MAILER_TEMPLATES_RECOVERY=https://crm.tudominio.com/correo/recuperacion.html

# ----------------------------------------------------------------------------
# NOTIFICAÇÕES PUSH (Web Push / VAPID). Gerar UMA vez: npx web-push generate-vapid-keys
# ----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:REEMPLAZA_tu@email.com

# ----------------------------------------------------------------------------
# DOCUMENTOS DA FICHA (bucket compatível com S3: Cloudflare R2, MinIO, Supabase Storage)
# ----------------------------------------------------------------------------
# Sem estas variáveis a seção Documentos avisa e o resto do CRM não fica sabendo.
# O bucket precisa de CORS para a origem do CRM: `npm run storage:setup`.
# S3_ENDPOINT=https://REEMPLAZA_account.r2.cloudflarestorage.com
# S3_BUCKET=builder-crm-documentos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ----------------------------------------------------------------------------
# OPERAÇÃO (Docker / Coolify)
# ----------------------------------------------------------------------------
# Varreduras de recuperação dentro do processo (não se aplica na Vercel). Minutos entre
# execuções; SWEEPERS_DISABLED=true as desliga.
# SWEEP_INTERVAL_MIN=30
# SWEEPERS_DISABLED=false
# O entrypoint roda as migrações ao subir; true as pula (réplicas).
# SKIP_MIGRATIONS=false
# Commit do build, para /api/health (Coolify e compose passam como build arg).
# SOURCE_COMMIT=

# ----------------------------------------------------------------------------
# MÓDULOS OPCIONAIS (cada módulo documenta as suas no README)
# ----------------------------------------------------------------------------
# modules/propiedades: embeddings para busca semântica (sem isto, busca por filtros)
# OPENAI_API_KEY=
# modules/propiedades: catálogo a partir do Tokko Broker (npm run sync:tokko)
# TOKKO_API_KEY=
# modules/propiedades: ler links de portais imobiliários
# FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------------
# AUTOVERIFICAÇÃO (scripts/verificar-instancia.mjs; também se passam por flags)
# ----------------------------------------------------------------------------
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
