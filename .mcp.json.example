{
  "//": "EXEMPLO. Copiar para .mcp.json (ignorado pelo git) e completar. Nunca colar tokens reais neste arquivo de exemplo. Guia de cada credencial em docs/MCP.md.",

  "mcpServers": {
    "supabase": {
      "//": "Modo CONTA (sem project_ref): permite criar projetos. Ao abri-lo o Claude Code pede iniciar sessão no Supabase (OAuth). Para limitá-lo a um projeto: https://mcp.supabase.com/mcp?project_ref=<ref>",
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },

    "coolify": {
      "//": "MCP comunitário com escrita (criar apps, variáveis, deploy). O MCP oficial do Coolify v4 é só de leitura. Verificar o nome do pacote no repositório escolhido (p. ex. github.com/stumason/coolify-mcp ou github.com/forsonny/Coolify-MCP-Server-for-Claude-Code). Sem MCP, deploy-coolify usa a REST API com curl.",
      "command": "npx",
      "args": ["-y", "coolify-mcp"],
      "env": {
        "COOLIFY_BASE_URL": "https://coolify.tu-dominio.com",
        "COOLIFY_ACCESS_TOKEN": "${COOLIFY_TOKEN}"
      }
    },

    "playwright": {
      "//": "Navegar a instância para capturas e testes manuais (skill playwright-cli).",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },

    "next-devtools": {
      "//": "Diagnóstico de Next.js em desenvolvimento local.",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    }
  }
}
